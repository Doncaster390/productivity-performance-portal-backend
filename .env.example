# Use DATABASE_URL or STORAGE_URL when deploying with Vercel's Neon Postgres integration.
DATABASE_URL=
STORAGE_URL=

# Or configure an individual PostgreSQL connection.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
# Set to true for Supabase and other managed PostgreSQL services requiring TLS.
DB_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PIN=replace-with-a-strong-admin-password
# Comma-separated browser origins that may call this API.
ALLOWED_ORIGINS=http://localhost:3000,https://christopherrichardson-rgb.github.io
